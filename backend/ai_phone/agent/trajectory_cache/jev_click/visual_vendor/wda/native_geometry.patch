 }
 
++ (id<FBResponsePayload>)handleNativeGeometryProbe:(FBRouteRequest *)request
+{
+  XCUIApplication *app = request.session.activeApplication ?: XCUIApplication.fb_activeApplication;
+  NSDate *begin = [NSDate date];
+  static id<FBXCAccessibilityElement> cachedRoot = nil;
+  static NSString *cachedApp = nil;
+  NSString *appKey = [[app valueForKey:@"processID"] description];
+  if (cachedRoot == nil || ![cachedApp isEqualToString:appKey]) {
+    cachedRoot = [app fb_standardSnapshot].accessibilityElement;
+    cachedApp = appKey;
+  }
+  NSMutableArray *snapshotAttrs = [NSMutableArray arrayWithArray:FBStandardAttributeNames()];
+  [snapshotAttrs addObjectsFromArray:FBCustomAttributeNames()];
+  [snapshotAttrs addObject:FB_XCAXAVisibleFrameAttributeName];
+  NSError *snapshotError = nil;
+  id<FBXCElementSnapshot> root = [FBXCAXClientProxy.sharedClient snapshotForElement:cachedRoot attributes:snapshotAttrs inDepth:YES error:&snapshotError];
+  if (root == nil) { cachedRoot = nil; return FBResponseWithUnknownErrorFormat(@"Native snapshot failed: %@", snapshotError.localizedDescription); }
+
+  NSTimeInterval snapshotMs = -[begin timeIntervalSinceNow] * 1000;
+  NSDictionary *tree = JEVSnapshotTree(root, NO, 0);
+  return FBResponseWithObject(@{ @"version": @1, @"tree": tree,
+    @"timingsMs": @{ @"snapshot": @(snapshotMs) } });
+}
+
 @end

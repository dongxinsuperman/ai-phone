@@ -15,6 +15,36 @@
 #import "XCUIElement+FBUtilities.h"
 #import "FBXPath.h"
 
+#import "FBXCElementSnapshotWrapper+Helpers.h"
+#import "XCUIElement+FBVisibleFrame.h"
+#import "XCTestPrivateSymbols.h"
+#import "FBXCAXClientProxy.h"
+#import "XCUIElement+FBUID.h"
+#import "XCUIElement+FBWebDriverAttributes.h"
+
+
+static NSDictionary *JEVSnapshotTree(id<FBXCElementSnapshot> node, BOOL webParent, NSUInteger depth)
+{
+  FBXCElementSnapshotWrapper *w = [FBXCElementSnapshotWrapper ensureWrapped:node];
+  BOOL web = webParent || node.elementType == XCUIElementTypeWebView;
+  NSMutableDictionary *d = [NSMutableDictionary dictionary];
+  d[@"type"] = w.wdType ?: @"";
+  d[@"uid"] = w.fb_uid ?: @"";
+  d[@"label"] = node.label ?: @"";
+  d[@"name"] = w.wdName ?: @"";
+  d[@"value"] = node.value == nil ? @"" : [node.value description];
+  d[@"frame"] = NSStringFromCGRect(node.frame);
+  d[@"enabled"] = @(node.enabled);
+  d[@"visible"] = @([w isWDVisible]);
+  d[@"web"] = @(web);
+  if (!web) { @try { d[@"visibleFrame"] = NSStringFromCGRect(node.visibleFrame); } @catch (NSException *e) { d[@"visibleFrameError"] = e.name; } }
+  NSMutableArray *children = [NSMutableArray array];
+  if (depth >= 100 && node.children.count > 0) { d[@"truncated"] = @YES; }
+  if (depth < 100) { for (id<FBXCElementSnapshot> child in node.children) { [children addObject:JEVSnapshotTree(child, web, depth + 1)]; } }
+  d[@"children"] = children;
+  return d;
+}
+
 @implementation FBDebugCommands
 
